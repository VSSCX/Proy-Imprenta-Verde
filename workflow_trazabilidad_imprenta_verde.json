    {
      "id": "n20",
      "name": "Separar vencidas vs a tiempo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 750],
      "parameters": {
        "jsCode": "const items = $input.all(); const hoy = new Date(); hoy.setHours(0,0,0,0); const vencidas = []; const aTiempo = []; for (const item of items) { const r = item.json; if (!r.Fecha_Limite_Retorno) { aTiempo.push(r); continue; } const partes = String(r.Fecha_Limite_Retorno).split('/'); let lim; if (partes.length === 3) { lim = new Date(parseInt(partes[2]), parseInt(partes[1])-1, parseInt(partes[0])); } else { lim = new Date(r.Fecha_Limite_Retorno); } lim.setHours(0,0,0,0); if (lim < hoy) { const dias = Math.floor((hoy - lim) / 86400000); vencidas.push({...r, dias_atraso: dias}); } else { aTiempo.push(r); } } vencidas.sort((a,b) => b.dias_atraso - a.dias_atraso); return [{json:{vencidas:vencidas, a_tiempo:aTiempo, total_vencidas:vencidas.length, total_a_tiempo:aTiempo.length}}];"
      }
    },
    {
