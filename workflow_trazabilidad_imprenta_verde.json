        }
      },
      "parameters": {
        "sendTo": "={{ $json.Disenador_Asignado }}",
        "subject": "=[{{ $json.ID_OT }}] Cambio en pedido: {{ $json.campo_modificado }}",
        "emailType": "html",
        "message": "=<h2>Cambio registrado en tu pedido</h2><table border='1' cellpadding='8' cellspacing='0'><tr><td><b>ID OT</b></td><td>{{ $json.ID_OT }}</td></tr><tr><td><b>Cliente</b></td><td>{{ $json.Cliente }}</td></tr><tr><td><b>Campo modificado</b></td><td>{{ $json.campo_modificado }}</td></tr><tr><td><b>Nuevo valor</b></td><td>{{ $json[$json.campo_modificado] }}</td></tr></table><p><a href='YOUR_SHEETS_URL'>Ver en Google Sheets</a></p>",
        "options": {}
      }
    },
    {
      "id": "n14",
      "name": "Avisar cambio a secretarias",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1400, 400],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail - La Imprenta Verde"
        }
      },
      "parameters": {
        "sendTo": "secretarias@laimprentaverde.cl",
        "subject": "=[{{ $json.ID_OT }}] Pedido modificado — {{ $json.campo_modificado }}",
        "emailType": "html",
        "message": "=<h2>Modificacion detectada en pedido</h2><table border='1' cellpadding='8' cellspacing='0'><tr><td><b>ID OT</b></td><td>{{ $json.ID_OT }}</td></tr><tr><td><b>Cliente</b></td><td>{{ $json.Cliente }}</td></tr><tr><td><b>Campo modificado</b></td><td>{{ $json.campo_modificado }}</td></tr><tr><td><b>Nuevo valor</b></td><td>{{ $json[$json.campo_modificado] }}</td></tr><tr><td><b>Estado actual</b></td><td>{{ $json.Estado }}</td></tr></table><p><a href='YOUR_SHEETS_URL'>Ver en Google Sheets</a></p>",
        "options": {}
      }
    },
    {
      "id": "n15",
      "name": "Avisar al cliente por cambio de fecha",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1400, 500],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-cliente",
              "leftValue": "={{ $json.notificar_cliente }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
